+/* Lu AirPlay: report which address is announced, so users (and the Lu AirPlay
+ * app) can see on which network the receiver is visible */
+static void mdns_log_ipv4(uint32_t addr, const char *how, const char *ifname)
+{
+    char buf[INET_ADDRSTRLEN] = "0.0.0.0";
+    inet_ntop(AF_INET, &addr, buf, sizeof(buf));
+    printf("mDNS: announcing on IPv4 %s (%s%s%s)\n", buf, how,
+           (ifname && *ifname) ? ": " : "", (ifname && *ifname) ? ifname : "");
+    fflush(stdout);
+}
+
+#ifdef _WIN32
+/* adapters that are (almost) never the LAN the iPhone/Mac is on */
+static int mdns_is_virtual_adapter(const wchar_t *text)
+{
+    static const wchar_t *patterns[] = {
+        L"hyper-v", L"virtual", L"vethernet", L"wsl", L"vmware", L"virtualbox", L"tap-",
+        L"tap adapter", L"tailscale", L"wireguard", L"wintun", L"zerotier", L"hamachi",
+        L"radmin", L"openvpn", L"nordlynx", L"vpn", L"npcap", L"loopback", L"bluetooth", NULL
+    };
+    wchar_t lower[256];
+    size_t i;
+    if (!text) {
+        return 0;
+    }
+    for (i = 0; i < 255 && text[i]; i++) {
+        lower[i] = (text[i] >= L'A' && text[i] <= L'Z') ? text[i] + (L'a' - L'A') : text[i];
+    }
+    lower[i] = 0;
+    for (i = 0; patterns[i]; i++) {
+        if (wcsstr(lower, patterns[i])) {
+            return 1;
+        }
+    }
+    return 0;
+}
+#endif
